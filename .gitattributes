# 统一行尾：仓库内一律 LF，Windows 检出也不再转 CRLF
# 否则 core.autocrlf=true 会把 data/*.json、*.html、*.css、*.js 检出成 CRLF，
# 导致 python3 db/export.py --check 误报版本/内容不一致。
* text=auto eol=lf

# 二进制文件不做行尾转换
*.sqlite binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
